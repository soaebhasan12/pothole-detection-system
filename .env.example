# Telegram: create a bot with @BotFather and keep this token private.
BOT_TOKEN=
ADMIN_CHAT_ID=

# Runtime
BOT_ONLY=False
HEADLESS=False

# GPS
USE_SIMULATION=True
GPS_PORT=COM10
GPS_BAUDRATE=9600

# Model
YOLO_MODEL_PATH=assets/models/pothole_yolo.pt

# Input
USE_LIVE_CAMERA=False
VIDEO_WIDTH=1020
VIDEO_HEIGHT=500
VIDEO_FILE=assets/videos/sample_video.mp4
FRAME_SKIP=3
CAMERA_INDEX=0

# Output
SAVE_VIDEO=False
VIDEO_OUTPUT_PATH=.output/demo_output.avi
VIDEO_FPS=20

# Local storage
DB_PATH=data/pothole.db
DATA_DIR=data

# Detection
DUPLICATE_RADIUS_METERS=5.0
